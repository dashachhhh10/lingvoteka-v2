DATABASE_URL=postgresql://localhost:5432/lingvoteka
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
# Required for AI extraction, grammar theory, and exercises.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Required in production; share only with people allowed to register.
REGISTRATION_INVITE_CODE=
# Local private file storage for development. Production requires FILE_STORAGE=s3.
FILE_STORAGE=local
UPLOAD_DIR=./data/uploads
# Private S3-compatible bucket. API and worker must use the same settings.
S3_BUCKET=
S3_REGION=
# Leave blank for AWS S3. Set an HTTPS endpoint for another S3-compatible service.
S3_ENDPOINT=
# Optional when the server has an IAM role or another SDK credential source.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set SMTP values for password reset emails. Registration needs no email confirmation.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lingvoteka <noreply@example.com>
