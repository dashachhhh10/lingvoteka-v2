    "better-auth": "^1.4.0",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "prisma": "6.16.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
